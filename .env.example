# Copiar a .env y ajustar los valores

# Backend
BACKEND_PORT=3000

# MongoDB
MONGO_PORT=27017
MONGO_URI=mongodb://localhost:27017
MONGO_DB=admision_usac

# Neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cambiar_esta_clave

# Frontend (opcional): el servidor de desarrollo reenvía /api a http://localhost:3000.
# Para apuntar a otro backend, defina VITE_API_TARGET al iniciar el frontend, por ejemplo:
#   VITE_API_TARGET=http://localhost:3001 npm run dev
