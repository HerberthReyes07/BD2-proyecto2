    "reconstruir": "tsx scripts/reconstruir.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "mongodb": "^7.7.0",
    "multer": "^2.5.0",
    "neo4j-driver": "^6.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
