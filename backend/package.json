{
  "name": "admision-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API del proyecto final de Bases de Datos 2: ETL, consultas MongoDB y consultas Neo4j",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "load": "tsx scripts/load-csv.ts",
    "test": "node --import tsx --test tests/*.test.ts",
